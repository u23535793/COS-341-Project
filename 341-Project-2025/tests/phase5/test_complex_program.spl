glob { x y result }
proc {
    myproc(a) {
        local { temp }
        temp = (a plus 1);
        print temp
    }
}
func {
    myfunc(p) {
        local { }
        halt;
        return p
    }
}
main {
    var { }
    x = 10;
    y = 20;
    if (x > 5) {
        myproc(x)
    };
    while (y > 15) {
        y = (y minus 1)
    };
    result = myfunc(x);
    halt
}
